{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/notice.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
